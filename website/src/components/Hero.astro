---
/**
 * Custom Hero component for nestjs-filter landing page.
 * Replaces the default Starlight Hero with a code-first,
 * opinionated layout inspired by Drizzle/TanStack/Tailwind docs.
 */
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const isLanding = Astro.locals.starlightRoute.id === '';

// Code snippets as raw HTML strings to avoid JSX parsing issues
const heroCode = `<span class="hl-kw">import</span> { BaseFilter, FilterFor } <span class="hl-kw">from</span> <span class="hl-str">'@dudousxd/nestjs-filter'</span>;
<span class="hl-kw">import</span> { User } <span class="hl-kw">from</span> <span class="hl-str">'./user.entity'</span>;

<span class="hl-kw">export class</span> <span class="hl-type">UserFilter</span> <span class="hl-kw">extends</span> <span class="hl-type">BaseFilter</span>&lt;<span class="hl-type">User</span>&gt; {

  <span class="hl-dec">@FilterFor</span>(<span class="hl-str">'name'</span>)
  <span class="hl-fn">filterName</span>(<span class="hl-param">value</span>: <span class="hl-type">string</span>) {
    <span class="hl-kw">this</span>.qb.andWhere({ name: { <span class="hl-prop">$like</span>: <span class="hl-str">\`%\${value}%\`</span> } });
  }

  <span class="hl-dec">@FilterFor</span>(<span class="hl-str">'active'</span>)
  <span class="hl-fn">filterActive</span>(<span class="hl-param">value</span>: <span class="hl-type">boolean</span>) {
    <span class="hl-kw">this</span>.qb.andWhere({ active: value });
  }
}`;

const beforeCode = `<span class="hl-kw">async</span> <span class="hl-fn">findUsers</span>(<span class="hl-param">query</span>: <span class="hl-type">UserQuery</span>) {
  <span class="hl-kw">const</span> qb = <span class="hl-kw">this</span>.repo.createQueryBuilder(<span class="hl-str">'u'</span>);

  <span class="hl-kw">if</span> (query.name) {
    qb.andWhere({ name: { <span class="hl-prop">$like</span>: <span class="hl-str">\`%\${query.name}%\`</span> } });
  }
  <span class="hl-kw">if</span> (query.email) {
    qb.andWhere({ email: query.email });
  }
  <span class="hl-kw">if</span> (query.active !== <span class="hl-kw">undefined</span>) {
    qb.andWhere({ active: query.active });
  }
  <span class="hl-kw">if</span> (query.role) {
    qb.andWhere({ role: query.role });
  }
  <span class="hl-cm">// ...20 more fields</span>

  <span class="hl-kw">return</span> qb.getResultList();
}`;

const afterCode = `<span class="hl-dec">@ApplyFilter</span>(<span class="hl-type">UserFilter</span>)
<span class="hl-kw">async</span> <span class="hl-fn">findUsers</span>(
  <span class="hl-dec">@ApplyFilter</span>() filter: <span class="hl-type">UserFilter</span>,
) {
  <span class="hl-kw">return</span> filter.apply().getResultList();
}`;
---

{isLanding ? (
  <div class="custom-hero">
    {/* Section 1: Hero */}
    <section class="hero-top">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Alpha &mdash; API stabilising</span>
      </div>
      <p class="hero-tagline">Declarative filters for NestJS</p>
      <p class="hero-sub">
        Stop writing <code>if/if/if</code> chains. Define filter classes, decorate methods, let the library build your WHERE clauses.
      </p>

      <div class="hero-code-block">
        <div class="code-header">
          <span class="code-filename">user.filter.ts</span>
          <span class="code-lang">TypeScript</span>
        </div>
        <pre><code set:html={heroCode} /></pre>
      </div>

      <div class="hero-install">
        <div class="install-tabs">
          <span class="install-label">MikroORM</span>
        </div>
        <div class="install-cmd" id="install-cmd">
          <code>pnpm add @dudousxd/nestjs-filter @dudousxd/nestjs-filter-mikro-orm</code>
          <button class="copy-btn" aria-label="Copy install command" id="copy-install">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>
      </div>

      <div class="hero-links">
        <a href="/nestjs-filter/getting-started/" class="hero-link hero-link-primary">
          Get Started
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/nestjs-filter/reference/architecture/" class="hero-link">API Reference</a>
        <a href="https://github.com/DavideCarvalho/nestjs-filter" class="hero-link" target="_blank" rel="noopener">
          GitHub
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
      </div>
    </section>

    {/* Section 2: Before/After */}
    <section class="hero-compare">
      <h2 class="section-heading">Before <span class="heading-accent">&rarr;</span> After</h2>
      <div class="compare-grid">
        <div class="compare-card compare-before">
          <div class="compare-label">
            <span class="label-icon label-icon-bad">&#x2717;</span>
            The usual way
          </div>
          <pre><code set:html={beforeCode} /></pre>
        </div>
        <div class="compare-card compare-after">
          <div class="compare-label">
            <span class="label-icon label-icon-good">&#x2713;</span>
            With nestjs-filter
          </div>
          <pre><code set:html={afterCode} /></pre>
        </div>
      </div>
    </section>

    {/* Section 3: Features */}
    <section class="hero-features">
      <h2 class="section-heading">Why nestjs-filter</h2>
      <div class="features-grid">
        <div class="feature">
          <div class="feature-code"><code>@FilterFor('name')</code></div>
          <h3>Declarative filter classes</h3>
          <p>Map query params to filter methods with decorators. Each method gets the value and the query builder.</p>
        </div>
        <div class="feature">
          <div class="feature-code"><code>22 operators</code></div>
          <h3>Built-in operators</h3>
          <p><code>equals</code>, <code>contains</code>, <code>in</code>, <code>between</code>, <code>isNull</code>, and 17 more with AND/OR composition.</p>
        </div>
        <div class="feature">
          <div class="feature-code"><code>@ApplyFilter()</code></div>
          <h3>Controller integration</h3>
          <p>Param decorator that reads query or body depending on HTTP method. Automatic validation with class-validator.</p>
        </div>
        <div class="feature">
          <div class="feature-code"><code>FilterRunner.apply()</code></div>
          <h3>Service-level use</h3>
          <p>Use filters programmatically in services. Full NestJS dependency injection inside filter classes.</p>
        </div>
        <div class="feature">
          <div class="feature-code"><code>AsyncLocalStorage</code></div>
          <h3>Request isolation</h3>
          <p>Singleton filters with zero cross-request contamination. Thread-safe by design.</p>
        </div>
        <div class="feature">
          <div class="feature-code"><code>FilterTestingModule</code></div>
          <h3>Test-first</h3>
          <p>Mock query builders, isolated unit tests. No database needed to test filter logic.</p>
        </div>
      </div>
    </section>

    {/* Section 4: Packages */}
    <section class="hero-packages">
      <h2 class="section-heading">Packages</h2>
      <div class="packages-table-wrap">
        <table class="packages-table">
          <thead>
            <tr>
              <th>Package</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>@dudousxd/nestjs-filter</code></td>
              <td>Core: BaseFilter, FilterRunner, decorators, FilterModule</td>
            </tr>
            <tr>
              <td><code>@dudousxd/nestjs-filter-mikro-orm</code></td>
              <td>MikroORM 7 adapter</td>
            </tr>
            <tr>
              <td><code>@dudousxd/nestjs-filter-typeorm</code></td>
              <td>TypeORM 0.3+ adapter</td>
            </tr>
            <tr>
              <td><code>@dudousxd/nestjs-filter-client</code></td>
              <td>Client-side query builder (browser + Node, zero deps)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    {/* Section 5: CTA */}
    <section class="hero-cta">
      <p class="cta-text">Zero to filtering in under 5 minutes.</p>
      <a href="/nestjs-filter/getting-started/" class="hero-link hero-link-primary">
        Read the guide
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </section>
  </div>

  <script>
    const btn = document.getElementById('copy-install');
    const cmd = document.querySelector('#install-cmd code');
    if (btn && cmd) {
      btn.addEventListener('click', async () => {
        const text = cmd.textContent || '';
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('.copy-text');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy'; }, 1500);
        }
      });
    }
  </script>
) : (
  (() => {
    const { hero } = data;
    if (!hero) return null;
    const { title = data.title, tagline, actions = [] } = hero;
    return (
      <div class="hero-fallback">
        <div class="sl-flex stack">
          <div class="sl-flex copy">
            <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
            {tagline && <div class="tagline" set:html={tagline} />}
          </div>
        </div>
      </div>
    );
  })()
)}

<style>
  /* Hero layout */
  .custom-hero {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Section 1: Top hero */
  .hero-top {
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    border: 1px solid var(--sl-color-accent);
    opacity: 0.9;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-tagline {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--sl-color-white);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--sl-color-text-accent);
    max-width: 50ch;
    margin: 0 0 2rem;
    line-height: 1.5;
  }

  .hero-sub code {
    font-family: var(--sl-font-mono);
    font-size: 0.95em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  /* Hero code block */
  .hero-code-block {
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    max-width: 44rem;
    overflow: hidden;
  }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .code-filename {
    color: var(--sl-color-text-accent);
    font-weight: 500;
  }

  .code-lang {
    color: var(--sl-color-accent);
    opacity: 0.7;
  }

  .hero-code-block pre {
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    background: transparent;
    border: none;
  }

  .hero-code-block code {
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--sl-color-text);
  }

  /* Syntax highlighting */
  :global(.hl-kw) { color: #c586c0; }
  :global(.hl-str) { color: #ce9178; }
  :global(.hl-type) { color: #4ec9b0; }
  :global(.hl-fn) { color: #dcdcaa; }
  :global(.hl-dec) { color: #d4922a; }
  :global(.hl-param) { color: #9cdcfe; }
  :global(.hl-prop) { color: #9cdcfe; }
  :global(.hl-cm) { color: #6a9955; }

  :root[data-theme="light"] :global(.hl-kw) { color: #af00db; }
  :root[data-theme="light"] :global(.hl-str) { color: #a31515; }
  :root[data-theme="light"] :global(.hl-type) { color: #267f99; }
  :root[data-theme="light"] :global(.hl-fn) { color: #795e26; }
  :root[data-theme="light"] :global(.hl-dec) { color: #b87520; }
  :root[data-theme="light"] :global(.hl-param) { color: #001080; }
  :root[data-theme="light"] :global(.hl-prop) { color: #001080; }
  :root[data-theme="light"] :global(.hl-cm) { color: #008000; }

  /* Install bar */
  .hero-install {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .install-tabs {
    margin-bottom: 0.25rem;
  }

  .install-label {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-text-accent);
    opacity: 0.7;
  }

  .install-cmd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--sl-color-text);
    overflow-x: auto;
  }

  .install-cmd code {
    flex: 1;
    white-space: nowrap;
    font-family: inherit;
    background: none;
    padding: 0;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    padding: 0.3rem 0.6rem;
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  /* Hero links */
  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .hero-link:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .hero-link-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }

  .hero-link-primary:hover {
    opacity: 0.9;
    color: var(--sl-color-black);
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  /* Section 2: Compare */
  .hero-compare {
    padding: 3rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }

  .heading-accent {
    color: var(--sl-color-accent);
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .compare-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .compare-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .compare-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text-accent);
  }

  .label-icon {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .label-icon-bad { color: #e55; }
  .label-icon-good { color: #5a5; }

  .compare-card pre {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    background: var(--sl-color-bg-inline-code);
    border: none;
  }

  .compare-card code {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--sl-color-text);
  }

  .compare-before pre {
    opacity: 0.7;
  }

  /* Section 3: Features */
  .hero-features {
    padding: 3rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    transition: border-color 0.15s ease;
  }

  .feature:hover {
    border-color: var(--sl-color-accent);
  }

  .feature-code {
    margin-bottom: 0.75rem;
  }

  .feature-code code {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    padding: 0.2em 0.5em;
    border-radius: 0.25rem;
    font-weight: 500;
  }

  .feature h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
  }

  .feature p {
    font-size: 0.875rem;
    color: var(--sl-color-text-accent);
    line-height: 1.5;
    margin: 0;
  }

  .feature p code {
    font-family: var(--sl-font-mono);
    font-size: 0.8em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.1em 0.25em;
    border-radius: 3px;
  }

  /* Section 4: Packages */
  .hero-packages {
    padding: 3rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .packages-table-wrap {
    overflow-x: auto;
  }

  .packages-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .packages-table th {
    text-align: left;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .packages-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-text);
  }

  .packages-table tr:last-child td {
    border-bottom: none;
  }

  .packages-table tbody tr:nth-child(even) {
    background: var(--sl-color-bg-inline-code);
  }

  .packages-table tbody tr {
    transition: background-color 0.1s ease;
  }

  .packages-table tbody tr:hover {
    background: var(--sl-color-accent-low);
  }

  .packages-table code {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.15em 0.35em;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* Section 5: CTA */
  .hero-cta {
    padding: 3rem 0 2rem;
    text-align: center;
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 1.25rem;
  }

  .hero-cta .hero-link-primary {
    font-size: 1rem;
  }

  /* Fallback hero for non-landing pages */
  .hero-fallback {
    padding-bottom: 1rem;
  }

  .hero-fallback .stack {
    flex-direction: column;
    gap: 1rem;
  }

  .hero-fallback .copy {
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-fallback h1 {
    font-size: var(--sl-text-h1);
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: var(--sl-line-height-headings);
  }

  .hero-fallback .tagline {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
</style>
