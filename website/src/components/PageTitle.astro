---
/**
 * Custom PageTitle with monospace treatment for technical titles.
 */
const PAGE_TITLE_ID = '_top';
const title = Astro.locals.starlightRoute.entry.data.title;

// Detect if the title looks like a technical identifier (has dots, @, or camelCase)
const isTechnical = /[@.\-\/]/.test(title) || /^[a-z]/.test(title);
---

<h1 id={PAGE_TITLE_ID} class:list={[{ 'mono-title': isTechnical }]}>
  {title}
</h1>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    color: var(--sl-color-white);
    letter-spacing: -0.02em;
  }

  .mono-title {
    font-family: var(--sl-font-mono);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
