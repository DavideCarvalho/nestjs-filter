---
/**
 * Custom SiteTitle component.
 * Monospace font with a subtle version badge — monochromatic zinc palette.
 */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no">
  <span class="title-text">{siteTitle}</span>
  <span class="title-version">alpha</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .site-title:hover {
    color: var(--sl-color-text-accent);
  }

  .title-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .title-version {
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    background: var(--sl-color-bg-inline-code);
    padding: 0.15em 0.45em;
    border-radius: 3px;
    border: 1px solid var(--sl-color-hairline);
    opacity: 0.8;
    flex-shrink: 0;
  }
</style>
