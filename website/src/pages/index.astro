---
/**
 * Custom landing page for nestjs-filter.
 * Lives OUTSIDE Starlight — pure Astro page with its own HTML structure.
 * Monochromatic zinc palette, Effect.website inspired.
 */
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const docsHref = `${base}getting-started/`;
const githubHref = 'https://github.com/DavideCarvalho/nestjs-filter';

// ── Code snippets as raw HTML strings (curly braces break JSX) ──

const beforeCode = `<span class="hl-kw">async</span> <span class="hl-fn">findUsers</span>(<span class="hl-param">query</span>: <span class="hl-type">UserQuery</span>) {
  <span class="hl-kw">const</span> qb = <span class="hl-kw">this</span>.repo.createQueryBuilder(<span class="hl-str">'u'</span>);

  <span class="hl-kw">if</span> (query.name) {
    qb.andWhere({ name: { <span class="hl-prop">$like</span>: <span class="hl-str">\`%\${query.name}%\`</span> } });
  }
  <span class="hl-kw">if</span> (query.email) {
    qb.andWhere({ email: query.email });
  }
  <span class="hl-kw">if</span> (query.active !== <span class="hl-kw">undefined</span>) {
    qb.andWhere({ active: query.active });
  }
  <span class="hl-kw">if</span> (query.role) {
    qb.andWhere({ role: query.role });
  }
  <span class="hl-cm">// ...20 more fields</span>

  <span class="hl-kw">return</span> qb.getResultList();
}`;

const afterCode = `<span class="hl-dec">@Filterable</span>({ entity: <span class="hl-type">User</span> })
<span class="hl-kw">export class</span> <span class="hl-type">UserFilter</span> <span class="hl-kw">extends</span> <span class="hl-type">MikroOrmFilter</span>&lt;<span class="hl-type">User</span>&gt; {

  <span class="hl-dec">@FilterFor</span>()
  <span class="hl-fn">name</span>(<span class="hl-param">v</span>: <span class="hl-type">string</span>) {
    <span class="hl-kw">this</span>.<span class="hl-fn">whereLike</span>(<span class="hl-str">'name'</span>, v);
  }

  <span class="hl-dec">@FilterFor</span>()
  <span class="hl-fn">status</span>(<span class="hl-param">v</span>: <span class="hl-type">string</span>[]) {
    <span class="hl-kw">this</span>.<span class="hl-fn">whereIn</span>(<span class="hl-str">'status'</span>, v);
  }
}

<span class="hl-cm">// Controller: one line</span>
<span class="hl-dec">@Get</span>()
<span class="hl-fn">list</span>(<span class="hl-dec">@ApplyFilter</span>(<span class="hl-type">UserFilter</span>) <span class="hl-param">qb</span>) {
  <span class="hl-kw">return</span> qb.getResultList();
}`;

const feat1Code = `<span class="hl-kw">import</span> { Controller, Get } <span class="hl-kw">from</span> <span class="hl-str">'@nestjs/common'</span>;
<span class="hl-kw">import</span> { ApplyFilter } <span class="hl-kw">from</span> <span class="hl-str">'@dudousxd/nestjs-filter'</span>;
<span class="hl-kw">import</span> { <span class="hl-type">UserFilter</span> } <span class="hl-kw">from</span> <span class="hl-str">'./user.filter'</span>;

<span class="hl-dec">@Controller</span>(<span class="hl-str">'users'</span>)
<span class="hl-kw">export class</span> <span class="hl-type">UsersController</span> {
  <span class="hl-dec">@Get</span>()
  <span class="hl-fn">list</span>(<span class="hl-dec">@ApplyFilter</span>(<span class="hl-type">UserFilter</span>) <span class="hl-param">qb</span>: <span class="hl-type">QueryBuilder</span>) {
    <span class="hl-kw">return</span> qb.getResultList();
  }
}`;

const feat2Code = `<span class="hl-dec">@Filterable</span>({
  entity: <span class="hl-type">User</span>,
  autoFields: <span class="hl-kw">true</span>,
  allowed: [<span class="hl-str">'name'</span>, <span class="hl-str">'email'</span>, <span class="hl-str">'status'</span>, <span class="hl-str">'role'</span>],
})
<span class="hl-kw">export class</span> <span class="hl-type">UserFilter</span> <span class="hl-kw">extends</span> <span class="hl-type">MikroOrmFilter</span>&lt;<span class="hl-type">User</span>&gt; {}

<span class="hl-cm">// GET /users?name=Al&amp;status=active</span>
<span class="hl-cm">// =&gt; WHERE name = 'Al' AND status = 'active'</span>

<span class="hl-cm">// GET /users?name[contains]=Al&amp;age[gte]=18</span>
<span class="hl-cm">// =&gt; WHERE name LIKE '%Al%' AND age &gt;= 18</span>`;

const feat4Code = `<span class="hl-kw">import</span> { filterQuery } <span class="hl-kw">from</span> <span class="hl-str">'@dudousxd/nestjs-filter-client'</span>;

<span class="hl-kw">const</span> query = <span class="hl-fn">filterQuery</span>()
  .<span class="hl-fn">contains</span>(<span class="hl-str">'name'</span>, <span class="hl-str">'Al'</span>)
  .<span class="hl-fn">gte</span>(<span class="hl-str">'age'</span>, <span class="hl-kw">18</span>)
  .<span class="hl-fn">in</span>(<span class="hl-str">'status'</span>, [<span class="hl-str">'active'</span>, <span class="hl-str">'pending'</span>])
  .<span class="hl-fn">build</span>();

<span class="hl-cm">// =&gt; { where: [</span>
<span class="hl-cm">//   { field: 'name', operator: 'contains', value: 'Al' },</span>
<span class="hl-cm">//   { field: 'age', operator: 'gte', value: 18 },</span>
<span class="hl-cm">//   { field: 'status', operator: 'in', value: ['active','pending'] }</span>
<span class="hl-cm">// ]}</span>

<span class="hl-kw">const</span> qs = <span class="hl-fn">filterQuery</span>()
  .<span class="hl-fn">contains</span>(<span class="hl-str">'name'</span>, <span class="hl-str">'Al'</span>)
  .<span class="hl-fn">toQueryString</span>();
<span class="hl-cm">// =&gt; "name[contains]=Al"</span>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>nestjs-filter: Declarative query filters for NestJS</title>
    <meta name="description" content="Stop writing if/if/if chains. Declarative, ORM-agnostic filter classes for NestJS with MikroORM and TypeORM support." />
    <meta property="og:title" content="nestjs-filter: Declarative query filters for NestJS" />
    <meta property="og:description" content="Stop writing if/if/if chains. Declarative, ORM-agnostic filter classes for NestJS." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    {/* Fonts */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <style is:inline>
      @font-face {
        font-family: "Geist Sans";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-Variable.woff2") format("woff2");
      }
      @font-face {
        font-family: "JetBrains Mono";
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url("https://cdn.jsdelivr.net/gh/JetBrains/JetBrainsMono@2.304/fonts/variable/JetBrainsMono%5Bwght%5D.woff2") format("woff2");
      }
      @font-face {
        font-family: "JetBrains Mono";
        font-style: italic;
        font-weight: 100 800;
        font-display: swap;
        src: url("https://cdn.jsdelivr.net/gh/JetBrains/JetBrainsMono@2.304/fonts/variable/JetBrainsMono-Italic%5Bwght%5D.woff2") format("woff2");
      }
    </style>

    <style is:inline>
      /* ============================================================
         RESET & BASE
         ============================================================ */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --font-sans: "Geist Sans", ui-sans-serif, system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", "Menlo", monospace;

        /* Easing */
        --ease-out: cubic-bezier(0.25, 1, 0.5, 1);

        /* Dark mode (default) */
        --bg: #09090b;
        --bg-elevated: #18181b;
        --border: #27272a;
        --border-light: #18181b;
        --text: #fafafa;
        --text-muted: #a1a1aa;
        --text-dim: #71717a;
        --text-ghost: #52525b;
        --surface-hover: #18181b;
        --invert-bg: #fafafa;
        --invert-text: #09090b;
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg: #fafafa;
          --bg-elevated: #f4f4f5;
          --border: #e4e4e7;
          --border-light: #f4f4f5;
          --text: #18181b;
          --text-muted: #52525b;
          --text-dim: #a1a1aa;
          --text-ghost: #a1a1aa;
          --surface-hover: #f4f4f5;
          --invert-bg: #18181b;
          --invert-text: #fafafa;
        }
      }

      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        overflow-x: hidden;
      }

      code {
        font-family: var(--font-mono);
      }

      a { color: inherit; text-decoration: none; }

      /* ============================================================
         UTILITIES
         ============================================================ */
      .container {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ============================================================
         ANIMATIONS
         ============================================================ */
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .animate-in {
        opacity: 0;
        animation: fadeInUp 0.5s var(--ease-out) forwards;
      }

      .delay-1 { animation-delay: 0.1s; }
      .delay-2 { animation-delay: 0.2s; }
      .delay-3 { animation-delay: 0.3s; }
      .delay-4 { animation-delay: 0.4s; }

      /* Scroll-triggered */
      .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .animate-in {
          opacity: 1;
          animation: none;
        }
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* ============================================================
         NAV
         ============================================================ */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 3.5rem;
      }

      .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .nav-badge {
        font-family: var(--font-mono);
        font-size: 0.55rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-muted);
        background: var(--bg-elevated);
        padding: 0.15em 0.45em;
        border-radius: 3px;
        border: 1px solid var(--border);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .nav-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-muted);
        padding: 0.4rem 0.75rem;
        border-radius: 0.375rem;
        transition: color 0.15s var(--ease-out), background-color 0.15s var(--ease-out);
      }

      .nav-link:hover {
        color: var(--text);
        background: var(--surface-hover);
      }

      .nav-link svg {
        vertical-align: -2px;
      }

      /* ============================================================
         HERO
         ============================================================ */
      .hero {
        padding: 6rem 0 5rem;
        border-bottom: 1px solid var(--border);
      }

      @media (max-width: 48rem) {
        .hero { padding: 3.5rem 0 3rem; }
      }

      .hero-title {
        font-size: clamp(3.5rem, 9vw, 6rem);
        font-family: var(--font-mono);
        font-weight: 800;
        line-height: 1.0;
        letter-spacing: -0.04em;
        color: var(--text);
        margin-bottom: 1rem;
      }

      .hero-subtitle {
        font-size: clamp(1.1rem, 2.5vw, 1.3rem);
        color: var(--text-muted);
        max-width: 48ch;
        line-height: 1.5;
        margin-bottom: 2.5rem;
      }

      /* Hero actions */
      .hero-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 2.5rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.6rem 1.25rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border);
        color: var(--text-muted);
        transition: background-color 0.15s var(--ease-out), border-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
        cursor: pointer;
        background: transparent;
      }

      .btn:hover {
        background: var(--surface-hover);
        border-color: var(--text);
        color: var(--text);
      }

      .btn-primary {
        background: var(--invert-bg);
        border-color: var(--invert-bg);
        color: var(--invert-text);
        font-weight: 600;
      }

      .btn-primary:hover {
        background: transparent;
        border-color: var(--invert-bg);
        color: var(--invert-bg);
      }

      /* Install bar */
      .install-bar {
        max-width: 40rem;
        margin-bottom: 3rem;
      }

      .install-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-ghost);
        margin-bottom: 0.35rem;
        display: block;
      }

      .install-cmd {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text);
        overflow-x: auto;
      }

      .install-cmd code {
        flex: 1;
        white-space: nowrap;
        background: none;
        padding: 0;
      }

      .copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        padding: 0.25rem 0.5rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.65rem;
        cursor: pointer;
        transition: background-color 0.15s var(--ease-out), border-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
        white-space: nowrap;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        background: var(--surface-hover);
        border-color: var(--text);
        color: var(--text);
      }

      /* ============================================================
         COMPARE (Before / After)
         ============================================================ */
      .compare {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      @media (min-width: 56rem) {
        .compare {
          grid-template-columns: 1fr 1fr;
          gap: 1.5rem;
        }
      }

      .compare-card {
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
      }

      .compare-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        border-bottom: 1px solid var(--border);
        color: var(--text-muted);
      }

      .compare-icon {
        font-weight: 700;
        font-size: 0.85rem;
      }

      .compare-icon-bad { color: var(--text-dim); }
      .compare-icon-good { color: var(--text); }

      .compare-card pre {
        margin: 0;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        background: var(--bg-elevated);
        border: none;
      }

      .compare-card code {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.65;
        color: var(--text);
      }

      .compare-before pre {
        opacity: 0.55;
      }

      /* ============================================================
         SECTIONS
         ============================================================ */
      .section {
        padding: 5rem 0;
        border-bottom: 1px solid var(--border);
      }

      @media (max-width: 48rem) {
        .section { padding: 3rem 0; }
      }

      .section-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 0.75rem;
      }

      .section-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        margin-bottom: 3rem;
      }

      /* ============================================================
         FEATURES
         ============================================================ */

      /* -- Feature: full-width (code on top, caption below) -- */
      .feature-full {
        margin-bottom: 4rem;
      }

      .feature-full:last-child {
        margin-bottom: 0;
      }

      .feature-full .feature-text {
        margin-top: 1rem;
        max-width: 56ch;
      }

      .feature-full .feature-text h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
      }

      .feature-full .feature-text p {
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.65;
      }

      .feature-full .feature-text p code {
        font-size: 0.85em;
        background: var(--bg-elevated);
        padding: 0.1em 0.3em;
        border-radius: 3px;
        color: var(--text);
      }

      /* -- Feature: 50/50 grid row -- */
      .feature-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
        margin-bottom: 4rem;
      }

      .feature-row:last-child {
        margin-bottom: 0;
      }

      @media (min-width: 56rem) {
        .feature-row {
          grid-template-columns: 1fr 1fr;
          gap: 3rem;
        }
        .feature-row .feature-text {
          order: -1;
        }
      }

      .feature-row .feature-text h3,
      .feature-text h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.75rem;
        letter-spacing: -0.01em;
      }

      .feature-row .feature-text p,
      .feature-text p {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.65;
      }

      .feature-row .feature-text p code,
      .feature-text p code {
        font-size: 0.85em;
        background: var(--bg-elevated);
        padding: 0.1em 0.3em;
        border-radius: 3px;
        color: var(--text);
      }

      /* -- Feature: operator chips -- */
      .feature-operators {
        margin-bottom: 4rem;
      }

      .feature-operators .feature-text {
        margin-bottom: 1.25rem;
      }

      .operator-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1;
      }

      .operator-chip {
        display: inline-block;
        padding: 0.35rem 0.65rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .operator-chip-sep {
        display: inline-flex;
        align-items: center;
        color: var(--text-ghost);
        font-size: 0.7rem;
        user-select: none;
      }

      /* -- Shared feature code block -- */
      .feature-code {
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        overflow: hidden;
      }

      .feature-code-header {
        padding: 0.5rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-ghost);
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
      }

      .feature-code pre {
        margin: 0;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        background: var(--bg-elevated);
      }

      .feature-code code {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.65;
        color: var(--text);
      }

      /* ============================================================
         PACKAGES (inline list)
         ============================================================ */
      .packages-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      @media (min-width: 56rem) {
        .packages-list {
          flex-direction: row;
          flex-wrap: wrap;
          gap: 0.75rem 1.5rem;
        }
      }

      .pkg-item {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text);
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        transition: color 0.15s var(--ease-out);
      }

      .pkg-item:hover {
        color: var(--text-muted);
      }

      .pkg-item .pkg-sep {
        color: var(--text-ghost);
      }

      .pkg-item .pkg-desc {
        color: var(--text-muted);
        font-size: 0.8rem;
      }

      /* ============================================================
         CTA
         ============================================================ */
      .cta {
        padding: 5rem 0 4rem;
        text-align: center;
      }

      .cta-text {
        font-size: clamp(1.25rem, 3vw, 1.5rem);
        font-weight: 600;
        color: var(--text);
        margin-bottom: 1.5rem;
        letter-spacing: -0.01em;
      }

      /* ============================================================
         FOOTER
         ============================================================ */
      .footer {
        border-top: 1px solid var(--border);
        padding: 2rem 0;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-ghost);
      }

      .footer a {
        color: var(--text-muted);
        transition: color 0.15s var(--ease-out);
      }

      .footer a:hover {
        color: var(--text);
      }

      /* ============================================================
         SYNTAX HIGHLIGHTING (monochromatic)
         ============================================================ */
      .hl-kw  { color: #a1a1aa; font-weight: 500; }
      .hl-str { color: #d4d4d8; }
      .hl-type { color: #fafafa; font-weight: 500; }
      .hl-fn  { color: #e4e4e7; }
      .hl-dec { color: #fafafa; font-weight: 600; }
      .hl-param { color: #a1a1aa; }
      .hl-prop { color: #d4d4d8; }
      .hl-cm  { color: #52525b; font-style: italic; }

      @media (prefers-color-scheme: light) {
        .hl-kw  { color: #52525b; }
        .hl-str { color: #3f3f46; }
        .hl-type { color: #18181b; }
        .hl-fn  { color: #27272a; }
        .hl-dec { color: #18181b; }
        .hl-param { color: #52525b; }
        .hl-prop { color: #3f3f46; }
        .hl-cm  { color: #a1a1aa; }
      }

      /* ============================================================
         FOCUS
         ============================================================ */
      :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 2px;
      }
    </style>
  </head>

  <body>
    {/* ──────────── NAV ──────────── */}
    <nav class="nav">
      <div class="container nav-inner">
        <a href={base} class="nav-brand">
          nestjs-filter
          <span class="nav-badge">alpha</span>
        </a>
        <div class="nav-links">
          <a href={docsHref} class="nav-link">Docs</a>
          <a href={githubHref} class="nav-link" target="_blank" rel="noopener">
            GitHub
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>
    </nav>

    {/* ──────────── HERO ──────────── */}
    <section class="hero">
      <div class="container">
        <h1 class="hero-title animate-in">nestjs-filter</h1>
        <p class="hero-subtitle animate-in delay-1">Declarative query filters for NestJS.</p>

        <div class="hero-actions animate-in delay-2">
          <a href={docsHref} class="btn btn-primary">
            Get Started
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={githubHref} class="btn" target="_blank" rel="noopener">
            GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <div class="install-bar animate-in delay-3">
          <span class="install-label">Install</span>
          <div class="install-cmd" id="install-cmd">
            <code>pnpm add @dudousxd/nestjs-filter @dudousxd/nestjs-filter-mikro-orm</code>
            <button class="copy-btn" aria-label="Copy install command" id="copy-install" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span class="copy-text">Copy</span>
            </button>
          </div>
        </div>

        {/* Before / After */}
        <div class="compare">
          <div class="compare-card compare-before reveal">
            <div class="compare-header">
              <span class="compare-icon compare-icon-bad">&#x2717;</span>
              Without nestjs-filter
            </div>
            <pre><code set:html={beforeCode} /></pre>
          </div>
          <div class="compare-card reveal">
            <div class="compare-header">
              <span class="compare-icon compare-icon-good">&#x2713;</span>
              With nestjs-filter
            </div>
            <pre><code set:html={afterCode} /></pre>
          </div>
        </div>
      </div>
    </section>

    {/* ──────────── FEATURES ──────────── */}
    <section class="section">
      <div class="container">

        {/* Feature 1: @ApplyFilter decorator — full-width code on top, caption below */}
        <div class="feature-full reveal">
          <div class="feature-code">
            <div class="feature-code-header">
              <span>users.controller.ts</span>
              <span>TypeScript</span>
            </div>
            <pre><code set:html={feat1Code} /></pre>
          </div>
          <div class="feature-text">
            <h3><code>@ApplyFilter</code> decorator</h3>
            <p>One decorator in your controller. It reads query params (GET) or body (POST), validates with <code>class-validator</code>, dispatches to filter methods, and hands you back a ready-to-execute query builder.</p>
          </div>
        </div>

        {/* Feature 2: Auto-fields — text on left, code on right */}
        <div class="feature-row reveal">
          <div class="feature-code">
            <div class="feature-code-header">
              <span>user.filter.ts</span>
              <span>TypeScript</span>
            </div>
            <pre><code set:html={feat2Code} /></pre>
          </div>
          <div class="feature-text">
            <h3>Auto-fields</h3>
            <p>For simple equality and operator-based filters, skip writing methods entirely. Declare <code>autoFields: true</code> with an allowlist, and the adapter generates WHERE clauses from query params automatically. Bracket notation gives clients access to operators.</p>
          </div>
        </div>

        {/* Feature 3: Operators — horizontal chip list */}
        <div class="feature-operators reveal">
          <div class="feature-text">
            <h3>22 built-in operators</h3>
            <p>Compose with AND/OR logic via bracket notation. Works with both auto-fields and custom <code>@FilterFor</code> methods.</p>
          </div>
          <div class="operator-chips">
            <span class="operator-chip">equals</span>
            <span class="operator-chip">contains</span>
            <span class="operator-chip">startsWith</span>
            <span class="operator-chip">endsWith</span>
            <span class="operator-chip">gte</span>
            <span class="operator-chip">lte</span>
            <span class="operator-chip">gt</span>
            <span class="operator-chip">lt</span>
            <span class="operator-chip">between</span>
            <span class="operator-chip">in</span>
            <span class="operator-chip">notIn</span>
            <span class="operator-chip">isNull</span>
            <span class="operator-chip">isNotNull</span>
            <span class="operator-chip">isEmpty</span>
            <span class="operator-chip">isNotEmpty</span>
            <span class="operator-chip">iContains</span>
            <span class="operator-chip">notContains</span>
            <span class="operator-chip">notEquals</span>
            <span class="operator-chip">notBetween</span>
            <span class="operator-chip">exists</span>
            <span class="operator-chip">notExists</span>
            <span class="operator-chip">isAnyOf</span>
          </div>
        </div>

        {/* Feature 4: Client builder — full-width */}
        <div class="feature-full reveal">
          <div class="feature-code">
            <div class="feature-code-header">
              <span>client.ts</span>
              <span>TypeScript</span>
            </div>
            <pre><code set:html={feat4Code} /></pre>
          </div>
          <div class="feature-text">
            <h3>Client-side query builder</h3>
            <p>A fluent, type-safe API for building filter queries in the browser or Node. Zero dependencies. Generates the exact query format the server expects. Ship it to your frontend team.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ──────────── PACKAGES ──────────── */}
    <section class="section">
      <div class="container">
        <p class="section-label reveal">Ecosystem</p>
        <h2 class="section-title reveal">Packages</h2>
        <div class="packages-list reveal">
          <a href={`${githubHref}/tree/main/packages/core`} class="pkg-item" target="_blank" rel="noopener">
            @dudousxd/nestjs-filter <span class="pkg-sep">&middot;</span> <span class="pkg-desc">core</span>
          </a>
          <a href={`${githubHref}/tree/main/packages/mikro-orm`} class="pkg-item" target="_blank" rel="noopener">
            @dudousxd/nestjs-filter-mikro-orm <span class="pkg-sep">&middot;</span> <span class="pkg-desc">MikroORM 7</span>
          </a>
          <a href={`${githubHref}/tree/main/packages/typeorm`} class="pkg-item" target="_blank" rel="noopener">
            @dudousxd/nestjs-filter-typeorm <span class="pkg-sep">&middot;</span> <span class="pkg-desc">TypeORM</span>
          </a>
          <a href={`${githubHref}/tree/main/packages/client`} class="pkg-item" target="_blank" rel="noopener">
            @dudousxd/nestjs-filter-client <span class="pkg-sep">&middot;</span> <span class="pkg-desc">client builder</span>
          </a>
        </div>
      </div>
    </section>

    {/* ──────────── CTA ──────────── */}
    <div class="cta">
      <div class="container">
        <p class="cta-text reveal">Zero to filtering in under 5 minutes.</p>
        <a href={docsHref} class="btn btn-primary reveal">
          Read the guide
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    {/* ──────────── FOOTER ──────────── */}
    <footer class="footer">
      <div class="container">
        <p>
          MIT &middot; <a href={githubHref} target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>

    {/* ──────────── SCRIPTS ──────────── */}
    <script is:inline>
      // Copy install command
      const btn = document.getElementById('copy-install');
      const cmd = document.querySelector('#install-cmd code');
      if (btn && cmd) {
        btn.addEventListener('click', async () => {
          const text = cmd.textContent || '';
          await navigator.clipboard.writeText(text);
          const label = btn.querySelector('.copy-text');
          if (label) {
            label.textContent = 'Copied!';
            setTimeout(() => { label.textContent = 'Copy'; }, 1500);
          }
        });
      }

      // Scroll-triggered reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
