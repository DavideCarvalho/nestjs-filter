{
  "name": "@dudousxd/nestjs-filter-memory",
  "version": "0.0.0",
  "description": "In-memory adapter for @dudousxd/nestjs-filter: run the same structured filter/sort/paginate/search/distinct input against plain arrays.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-filter.git",
    "directory": "packages/memory"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/filter",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-filter/issues"
  },
  "keywords": ["nestjs", "filter", "query", "in-memory", "array", "tanstack-intent"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md", "skills"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-filter": "workspace:^",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "devDependencies": {
    "@dudousxd/nestjs-filter": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/node": "20.19.43",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
