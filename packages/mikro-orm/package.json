{
  "name": "@dudousxd/nestjs-filter-mikro-orm",
  "version": "1.33.0",
  "description": "MikroORM adapter for @dudousxd/nestjs-filter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-filter.git",
    "directory": "packages/mikro-orm"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md", "skills"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-filter": "workspace:^",
    "@mikro-orm/core": ">=7.0.0",
    "@mikro-orm/nestjs": ">=7.0.0",
    "@mikro-orm/sql": ">=7.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "devDependencies": {
    "@dudousxd/nestjs-filter": "workspace:*",
    "@mikro-orm/core": "7.1.1",
    "@mikro-orm/decorators": "7.1.1",
    "@mikro-orm/mysql": "7.1.1",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.1",
    "@mikro-orm/sql": "7.1.1",
    "@mikro-orm/sqlite": "7.1.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "20.19.41",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["tanstack-intent"]
}
