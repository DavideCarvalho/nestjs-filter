{
  "name": "@dudousxd/nestjs-filter-codegen",
  "version": "0.8.0",
  "description": "nestjs-codegen extension for @dudousxd/nestjs-filter — emits a typed filterQuery() helper on filtered routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-filter.git",
    "directory": "packages/codegen"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-codegen": ">=0.18.0",
    "@dudousxd/nestjs-filter-client": ">=1.25.0",
    "@dudousxd/nestjs-filter": ">=1.19.0"
  },
  "dependencies": {
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-codegen": "0.2.1",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0",
    "@dudousxd/nestjs-filter": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["nestjs", "filter", "codegen", "extension"]
}
