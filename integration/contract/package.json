{
  "name": "@integration/contract",
  "version": "0.0.25",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "pnpm run test:db:postgres && pnpm run test:db:mysql",
    "test:db:postgres": "CONTRACT_DB=postgres vitest run",
    "test:db:mysql": "CONTRACT_DB=mysql vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-filter": "workspace:*",
    "@dudousxd/nestjs-filter-mikro-orm": "workspace:*",
    "@dudousxd/nestjs-filter-typeorm": "workspace:*",
    "@mikro-orm/core": "^7.0.0",
    "@mikro-orm/decorators": "^7.0.0",
    "@mikro-orm/mysql": "^7.0.0",
    "@mikro-orm/nestjs": "^7.0.0",
    "@mikro-orm/postgresql": "^7.0.0",
    "@mikro-orm/sql": "^7.0.0",
    "@mikro-orm/sqlite": "^7.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "better-sqlite3": "^11.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/mysql": "^10.13.0",
    "@testcontainers/postgresql": "^10.13.0",
    "testcontainers": "^10.13.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  }
}
