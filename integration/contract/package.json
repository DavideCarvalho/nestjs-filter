{
  "name": "@integration/contract",
  "version": "0.0.36",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "pnpm run test:db:postgres && pnpm run test:db:mysql",
    "test:db:postgres": "CONTRACT_DB=postgres vitest run",
    "test:db:mysql": "CONTRACT_DB=mysql vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-filter": "workspace:*",
    "@dudousxd/nestjs-filter-mikro-orm": "workspace:*",
    "@dudousxd/nestjs-filter-typeorm": "workspace:*",
    "@mikro-orm/core": "7.1.1",
    "@mikro-orm/decorators": "7.1.1",
    "@mikro-orm/mysql": "7.1.1",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.1.1",
    "@mikro-orm/sql": "7.1.1",
    "@mikro-orm/sqlite": "7.1.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "better-sqlite3": "11.10.0",
    "mysql2": "3.22.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@testcontainers/mysql": "10.28.0",
    "@testcontainers/postgresql": "10.28.0",
    "testcontainers": "10.28.0",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
